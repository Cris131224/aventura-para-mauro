<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Aventura para Mauro</title>

<style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,sans-serif;
  color:white;
  background:linear-gradient(135deg,#090d2b,#1d0b35,#071d3d);
  min-height:100vh;
  display:flex;
  justify-content:center;
  align-items:center;
  text-align:center;
}
.game{
  width:92%;
  max-width:500px;
  padding:25px;
  border:2px solid #4d8cff;
  border-radius:25px;
  background:rgba(10,10,35,.9);
  box-shadow:0 0 30px #174cff;
}
h1{color:#ff4b6e}
h2{color:#65a8ff}
button{
  border:0;
  border-radius:15px;
  padding:14px 20px;
  margin:8px;
  font-size:16px;
  font-weight:bold;
  cursor:pointer;
  background:linear-gradient(90deg,#e92d55,#287cff);
  color:white;
}
button:hover{transform:scale(1.04)}
.screen{display:none}
.active{display:block}
.star{
  font-size:45px;
  animation:float 2s infinite alternate;
}
@keyframes float{
  from{transform:translateY(0)}
  to{transform:translateY(-10px)}
}
.message{
  background:rgba(255,255,255,.08);
  border-radius:18px;
  padding:18px;
  margin:15px 0;
  line-height:1.6;
}
.choice{
  display:block;
  width:90%;
  margin:12px auto;
}
</style>
</head>

<body>

<div class="game">

<div id="start" class="screen active">
  <div class="star">⭐</div>
  <h1>✨ La aventura de Cristhel y Mauro ✨</h1>
  <p>Una pequeña aventura de fantasía preparada especialmente para ti.</p>
  <button onclick="startGame()">Comenzar aventura 🎮</button>
</div>

<div id="level1" class="screen">
  <div class="star">🌌</div>
  <h2>Nivel 1: El portal mágico</h2>
  <p>Has encontrado un portal entre dos mundos.</p>
  <p>Para abrirlo necesitas elegir un símbolo:</p>
  <button onclick="next('level2')">❤️ Rojo</button>
  <button onclick="next('level2')">💙 Azul</button>
</div>

<div id="level2" class="screen">
  <div class="star">🗺️</div>
  <h2>Nivel 2: Los caminos</h2>
  <p>Hay tres caminos. Uno te llevará a la siguiente parte de la aventura.</p>

  <button class="choice" onclick="next('level3')">🌹 Camino de las rosas</button>
  <button class="choice" onclick="next('level3')">⭐ Camino de las estrellas</button>
  <button class="choice" onclick="next('level3')">🔥 Camino de las llamas</button>
</div>

<div id="level3" class="screen">
  <div class="star">🎂</div>
  <h2>Nivel 3: La fecha especial</h2>
  <p>Una puerta mágica pregunta:</p>
  <h3>¿Cuál es la fecha que debe recordar este mundo?</h3>

  <button onclick="correct()">29 de septiembre ❤️</button>
  <button onclick="wrong()">25 de diciembre</button>
  <button onclick="wrong()">14 de febrero</button>

  <p id="answer"></p>
</div>

<div id="level4" class="screen">
  <div class="star">✨</div>
  <h2>Nivel 4: Las estrellas</h2>

  <p>Encuentra las tres estrellas mágicas:</p>

  <button onclick="starFound(this)">⭐ Estrella roja</button>
  <button onclick="starFound(this)">⭐ Estrella azul</button>
  <button onclick="starFound(this)">⭐ Estrella secreta</button>

  <p id="stars">Estrellas encontradas: 0/3</p>
</div>

<div id="final" class="screen">
  <div class="star">🎁</div>
  <h1>🎉 ¡Aventura completada! 🎉</h1>

  <div class="message">
    <h2>💙❤️ Para Mauro ❤️💙</h2>

    <p>
      ¡Feliz cumpleaños, mi niño Mauro! 🎂✨
    </p>

    <p>
      Esta pequeña aventura fue creada especialmente para celebrar
      tu día y dejarte un recuerdo bonito.
    </p>

    <p>
      Que este nuevo año esté lleno de momentos felices,
      sueños, aventuras y muchas cosas buenas. 🌟
    </p>

    <h2>🔐 Mensaje secreto</h2>

    <p>
      Gracias por ser una persona tan especial.
      Espero que este pequeño regalo te saque una sonrisa. ❤️💙
    </p>

    <p>— Cristhel 🌹</p>
  </div>

  <button onclick="location.reload()">🔄 Jugar otra vez</button>
</div>

</div>

<script>
let found=0;

function show(id){
  document.querySelectorAll('.screen')
    .forEach(x=>x.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}

function startGame(){
  playMusic();
  show('level1');
}

function next(id){
  show(id);
}

function correct(){
  document.getElementById('answer').innerHTML=
  "✨ ¡Correcto! El portal se ha abierto. ✨";
  setTimeout(()=>show('level4'),1000);
}

function wrong(){
  document.getElementById('answer').innerHTML=
  "🌟 Esa no es la fecha secreta. ¡Inténtalo otra vez!";
}

function starFound(button){
  if(button.disabled) return;

  button.disabled=true;
  found++;

  document.getElementById('stars').innerText=
    "Estrellas encontradas: "+found+"/3";

  if(found===3){
    setTimeout(()=>show('final'),800);
  }
}

/* Música tranquila generada por el navegador */
let audioCtx;
let musicStarted=false;

function playMusic(){
  if(musicStarted) return;

  musicStarted=true;
  audioCtx=new (window.AudioContext||window.webkitAudioContext)();

  const notes=[261.63,329.63,392,329.63,293.66,349.23,440,349.23];

  notes.forEach((freq,i)=>{
    const osc=audioCtx.createOscillator();
    const gain=audioCtx.createGain();

    osc.frequency.value=freq;
    osc.type="sine";

    gain.gain.setValueAtTime(0,audioCtx.currentTime+i*.7);
    gain.gain.linearRampToValueAtTime(.04,audioCtx.currentTime+i*.7+.1);
    gain.gain.linearRampToValueAtTime(0,audioCtx.currentTime+i*.7+.6);

    osc.connect(gain);
    gain.connect(audioCtx.destination);

    osc.start(audioCtx.currentTime+i*.7);
    osc.stop(audioCtx.currentTime+i*.7+.7);
  });
}
</script>

</body>
</html>
